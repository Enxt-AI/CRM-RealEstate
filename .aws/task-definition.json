{
    "family": "crm-dashboard-task-defination",
    "containerDefinitions": [
        {
            "name": "crm-api",
            "image": "477476326224.dkr.ecr.ap-south-1.amazonaws.com/crm-api:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "crm-dashboard-3001",
                    "containerPort": 3001,
                    "hostPort": 3001,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "AWS_REGION",
                    "value": "ap-south-1"
                },
                {
                    "name": "GOOGLE_CLIENT_SECRET",
                    "value": "your_client_secret_here"
                },
                {
                    "name": "DATABASE_URL",
                    "value": "postgresql://postgres.plqxzehnqpqbcvupkrwc:govindrajgupta@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
                },
                {
                    "name": "PORT",
                    "value": "3001"
                },
                {
                    "name": "AWS_ACCESS_KEY_ID",
                    "value": "AKIA57ZKOB6SJ7EFS26J"
                },
                {
                    "name": "JWT_SECRET",
                    "value": "crm-dev-jwt-secret-key-change-in-production"
                },
                {
                    "name": "GOOGLE_CLIENT_ID",
                    "value": "your_client_id_here"
                },
                {
                    "name": "AWS_SECRET_ACCESS_KEY",
                    "value": "gzpS8DpL5rcQoNCW7TngPhzSlEqosBZwL0W/BRu9"
                },
                {
                    "name": "S3_BUCKET_NAME",
                    "value": "crm-documents-enxt"
                },
                {
                    "name": "DIRECT_URL",
                    "value": "postgresql://postgres.plqxzehnqpqbcvupkrwc:govindrajgupta@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
                },
                {
                    "name": "CORS_ORIGIN",
                    "value": "http://crm-dashboard-alg-492196079.ap-south-1.elb.amazonaws.com"
                },
                {
                    "name": "GOOGLE_REDIRECT_URI",
                    "value": "http://crm-dashboard-alg-492196079.ap-south-1.elb.amazonaws.com/auth/google/callback"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/crm-api",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "curl -f http://localhost:3001/health || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 60
            },
            "systemControls": []
        },
        {
            "name": "crm-frontend",
            "image": "477476326224.dkr.ecr.ap-south-1.amazonaws.com/crm-frontend:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "crm-dashboard-3000",
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "NEXT_PUBLIC_API_UR",
                    "value": "http://crm-dashboard-alg-492196079.ap-south-1.elb.amazonaws.com"
                },
                {
                    "name": "NODE_ENV",
                    "value": "production"
                },
                {
                    "name": "HOSTNAME",
                    "value": "0.0.0.0"
                },
                {
                    "name": "PORT",
                    "value": "3000"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/crm-frontend",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "wget -q --spider http://localhost:3000/ || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 60
            },
            "systemControls": []
        }
    ],
    "taskRoleArn": "arn:aws:iam::477476326224:role/service-role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::477476326224:role/service-role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "3072",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "enableFaultInjection": false
}